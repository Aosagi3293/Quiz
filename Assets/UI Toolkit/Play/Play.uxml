<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Container" picking-mode="Ignore" style="flex-grow: 1; background-color: rgb(144, 148, 205);">
        <ui:Label text="問題" picking-mode="Ignore" name="QuestionTitle" style="position: absolute; top: 400px; left: 50%; height: 372px; width: 1130px; -unity-text-align: upper-center; font-size: 54px; -unity-font-style: bold; translate: -50% -50%; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(242, 229, 229); border-top-width: 17px; border-right-width: 17px; border-bottom-width: 17px; border-left-width: 17px; border-left-color: rgb(128, 128, 128); border-right-color: rgb(128, 128, 128); border-top-color: rgb(128, 128, 128); border-bottom-color: rgb(128, 128, 128); display: flex;">
            <ui:Label text="問題文" name="QuestionText" picking-mode="Ignore" style="top: 20%; height: 258px; justify-content: flex-start; -unity-text-align: middle-center; font-size: 52px;"/>
        </ui:Label>
        <ui:VisualElement name="Answers" picking-mode="Ignore" style="flex-grow: 1; position: absolute; width: 1547px; top: 800px; left: 50%; height: 326px; flex-direction: row; flex-wrap: wrap; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(242, 229, 229); flex-basis: auto; align-items: center; justify-content: center; align-self: center; align-content: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-left-color: rgb(128, 128, 128); border-right-color: rgb(128, 128, 128); border-top-color: rgb(128, 128, 128); border-bottom-color: rgb(128, 128, 128); translate: -50% -50%;">
            <ui:Button text="回答１" parse-escape-sequences="false" name="Answer1" style="width: 49%; height: 45%; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; background-color: rgb(229, 229, 229); -unity-font-style: bold; font-size: 48px; -unity-text-align: middle-center; -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0);">
                <ui:Label text="A." picking-mode="Ignore" name="IsAnswer1" style="align-items: flex-start; justify-content: center; align-self: flex-start; align-content: center; width: 17%; height: 100%; font-size: 90px;"/>
            </ui:Button>
            <ui:Button text="回答2" parse-escape-sequences="false" name="Answer2" style="width: 49%; height: 45%; border-left-color: rgb(0, 0, 255); border-right-color: rgb(0, 0, 255); border-top-color: rgb(0, 0, 255); border-bottom-color: rgb(0, 0, 255); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; background-color: rgb(229, 229, 229); -unity-font-style: bold; font-size: 48px;">
                <ui:Label text="B." picking-mode="Ignore" name="IsAnswer2" style="align-items: flex-start; justify-content: center; align-self: flex-start; align-content: center; width: 17%; height: 100%; font-size: 90px;"/>
            </ui:Button>
            <ui:Button text="回答3" parse-escape-sequences="false" name="Answer3" style="width: 49%; height: 45%; border-left-color: rgb(255, 215, 0); border-right-color: rgb(255, 215, 0); border-top-color: rgb(255, 215, 0); border-bottom-color: rgb(255, 215, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; background-color: rgb(229, 229, 229); -unity-font-style: bold; font-size: 48px;">
                <ui:Label text="C." picking-mode="Ignore" name="IsAnswer3" style="align-items: flex-start; justify-content: center; align-self: flex-start; align-content: center; width: 17%; height: 100%; font-size: 90px;"/>
            </ui:Button>
            <ui:Button text="回答4" parse-escape-sequences="false" name="Answer4" style="width: 49%; height: 45%; border-left-color: rgb(0, 255, 0); border-right-color: rgb(0, 255, 0); border-top-color: rgb(0, 255, 0); border-bottom-color: rgb(0, 255, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; background-color: rgb(229, 229, 229); -unity-font-style: bold; font-size: 48px;">
                <ui:Label text="D." picking-mode="Ignore" name="IsAnswer4" style="align-items: flex-start; justify-content: center; align-self: flex-start; align-content: center; width: 17%; height: 100%; font-size: 90px;"/>
            </ui:Button>
